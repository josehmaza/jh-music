<?xml version="1.0" encoding="utf-8"?>
<!-- Carátula presionada (igual que la web, .album-art-container:active): borde cian, sin tapar la imagen.
     Además el código la achica al 97 % mientras el dedo está encima -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="20dp" />
            <stroke android:width="3dp" android:color="#b338bdf8" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
