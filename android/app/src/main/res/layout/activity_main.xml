<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_root">

    <!-- ======================================================== -->
    <!-- BARRA SUPERIOR DE ESTADO DEL VEHÍCULO (38dp)              -->
    <!-- Marca, ruta USB actual, reloj central y re-escaneo USB    -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/layoutCarStatusBar"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#0d0f14">

        <!-- Lado Izquierdo: Marca y Ruta Activa -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="● HYUNDAI TUCSON IX"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderPath"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:singleLine="true"
                android:ellipsize="middle"
                android:text="Q hubo jefe 😉"
                android:textColor="@color/accent_cyan"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Centro: Reloj del Auto -->
        <TextView
            android:id="@+id/tvClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01:30"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Lado Derecho: Botón Re-escanear USB -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRescanUsb"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_btn_action"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="🔄 Re-escanear USB"
                android:textColor="@color/accent_cyan"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Línea divisoria sutil -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_panel" />

    <!-- ======================================================== -->
    <!-- CUERPO PRINCIPAL ERGONÓMICO DE 3 COLUMNAS                -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/layoutMainGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- ======================================================== -->
        <!-- COLUMNA 1: FRANJA DE VOLUMEN CONDUCTOR (54dp)            -->
        <!-- ======================================================== -->
        <LinearLayout
            android:id="@+id/layoutVolumeStrip"
            android:layout_width="54dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="2dp"
            android:background="@drawable/bg_volume_strip">

            <!-- Botón HOME Táctil (Mismo comportamiento que el botón físico HOME del auto) -->
            <ImageButton
                android:id="@+id/btnNavHome"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_btn_action"
                android:src="@drawable/ic_nav_home"
                android:contentDescription="Inicio (Home)" />

            <!-- Botón Silencio (Mute) -->
            <ImageButton
                android:id="@+id/btnVolMute"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_btn_action"
                android:src="@android:drawable/ic_lock_silent_mode"
                android:contentDescription="Mute" />

            <!-- Botón Subir (+) -->
            <Button
                android:id="@+id/btnVolUp"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_btn_action"
                android:text="+"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Porcentaje de Volumen (En medio de + y -) -->
            <TextView
                android:id="@+id/tvVolPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="4dp"
                android:text="75%"
                android:textColor="@color/accent_cyan"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Botón Bajar (-) -->
            <Button
                android:id="@+id/btnVolDown"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_btn_action"
                android:text="-"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Barra Deslizante Vertical Táctil Ergonómica (Abajo de + y -, ocupando hasta el fondo de la pantalla) -->
            <com.jh.caraudio.VerticalVolumeBar
                android:id="@+id/seekVolume"
                android:layout_width="44dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="2dp" />
        </LinearLayout>

        <!-- ======================================================== -->
        <!-- COLUMNA 2: EXPLORADOR DE ARCHIVOS Y PISTAS (Izquierda)     -->
        <!-- ======================================================== -->
        <LinearLayout
            android:id="@+id/layoutExplorerPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@drawable/bg_panel_card"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="8dp">

                <!-- Pestañas de Navegación Ampliadas para Conducción (16sp y 44dp) y Botón Colapsar Árbol -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/tabFolders"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tab_selected"
                        android:text="📁 Carpetas USB"
                        android:textColor="@color/accent_cyan"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/tabTracks"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_tab_unselected"
                        android:text="🎵 Pistas (0)"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/tabFavorites"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_tab_unselected"
                        android:text="⭐ Favoritos"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Botón Colapsar Todo a nivel de Pendrives (Visible en pestaña Carpetas USB) -->
                    <ImageButton
                        android:id="@+id/btnCollapseAllTree"
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_btn_action"
                        android:src="@drawable/ic_collapse_all"
                        android:tint="@color/accent_cyan"
                        android:padding="8dp"
                        android:contentDescription="Colapsar todo el árbol" />
                </LinearLayout>

                <!-- Panel de Filtros Rápidos (Esta Carpeta, TODO, USB 1, USB 2) en 16sp y 34dp (Oculto en pestaña Carpetas USB) -->
                <HorizontalScrollView
                    android:id="@+id/scrollSearchFilters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:visibility="gone"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:id="@+id/layoutSearchFilters"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Filtro Esta Carpeta (Activo por defecto en pestaña Pistas) -->
                        <TextView
                            android:id="@+id/btnFilterFolder"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:background="@drawable/bg_chip_selected"
                            android:text="📁 Esta Carpeta"
                            android:textColor="#0d0f14"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />

                        <!-- Filtro Todo -->
                        <TextView
                            android:id="@+id/btnFilterAll"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:background="@drawable/bg_chip_unselected"
                            android:text="🌐 TODO"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />

                        <!-- Filtro USB 1 -->
                        <TextView
                            android:id="@+id/btnFilterUsb1"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="14dp"
                            android:background="@drawable/bg_chip_unselected"
                            android:drawableStart="@drawable/ic_usb_trident"
                            android:drawablePadding="5dp"
                            android:text="1"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />

                        <!-- Filtro USB 2 -->
                        <TextView
                            android:id="@+id/btnFilterUsb2"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="14dp"
                            android:background="@drawable/bg_chip_unselected"
                            android:drawableStart="@drawable/ic_usb_trident"
                            android:drawablePadding="5dp"
                            android:text="2"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Barra de Búsqueda Ergonómica (46dp y texto 17sp negrita) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_search"
                    android:paddingStart="12dp"
                    android:paddingEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔍"
                        android:textColor="@color/accent_cyan"
                        android:textSize="18sp" />

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@null"
                        android:hint="Buscar canción, carpeta o artista..."
                        android:textColorHint="@color/text_muted"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:imeOptions="actionDone" />

                    <!-- Indicador de búsqueda animado estilo web -->
                    <com.jh.caraudio.SearchSpinnerView
                        android:id="@+id/pbSearchLoading"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginEnd="6dp"
                        android:visibility="gone" />

                    <!-- Botón X para borrar búsqueda y cerrar teclado -->
                    <ImageButton
                        android:id="@+id/btnSearchClear"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_btn_action"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:visibility="gone"
                        android:tint="@color/text_secondary"
                        android:contentDescription="Borrar búsqueda" />
                </LinearLayout>

                <!-- TextView oculto para mantener compatibilidad sin consumir espacio vertical -->
                <TextView
                    android:id="@+id/tvCurrentPath"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <!-- Contenedor de Lista con FastScroller Táctil y Burbuja Flotante A-Z para 200+ canciones -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="4dp">

                    <ListView
                        android:id="@+id/listViewContent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:divider="@color/border_panel"
                        android:dividerHeight="1dp"
                        android:descendantFocusability="blocksDescendants"
                        android:cacheColorHint="#00000000"
                        android:fastScrollEnabled="true"
                        android:fastScrollAlwaysVisible="false"
                        android:scrollbars="vertical" />

                    <!-- Deslizador Rápido Táctil Ergonómico Lateral para Conducción (38dp de ancho táctil) -->
                    <LinearLayout
                        android:id="@+id/layoutFastScrollerTrack"
                        android:layout_width="38dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:orientation="vertical"
                        android:background="@drawable/bg_fastscroll_track"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="false"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp">

                        <!-- Deslizador / Thumb táctil que se arrastra verticalmente -->
                        <View
                            android:id="@+id/viewFastScrollThumb"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_fastscroll_thumb" />
                    </LinearLayout>

                    <!-- Burbuja Flotante de Previsualización Prominente (Letra A-Z y Número de Pista) -->
                    <LinearLayout
                        android:id="@+id/layoutFastScrollBubble"
                        android:layout_width="120dp"
                        android:layout_height="110dp"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_bubble_floating"
                        android:elevation="14dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvFastScrollBubbleLetter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="A"
                            android:textColor="@color/accent_cyan"
                            android:textSize="44sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvFastScrollBubbleTrackNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-2dp"
                            android:text="1 / 200"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Pie de Estado de Almacenamiento y Botón Reproducir Todo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tvStorageStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:text="Escaneando pendrives USB..."
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnPlayAll"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_btn_action"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="▶ Reproducir Todo"
                        android:textColor="@color/accent_cyan"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- ======================================================== -->
        <!-- COLUMNA 3: REPRODUCTOR PRINCIPAL (Derecha)                         -->
        <!-- ======================================================== -->
        <LinearLayout
            android:id="@+id/layoutPlayerPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:orientation="vertical"
            android:padding="8dp"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@drawable/bg_panel_card"
                android:padding="10dp"
                android:gravity="center_horizontal">

                <!-- Barra superior interna del reproductor -->
                <!-- Barra superior y Carátula con Zona Táctil Ampliada para el Conductor -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Estado Dinámico: EN PAUSA / REPRODUCIENDO -->
                    <TextView
                        android:id="@+id/tvPlaybackStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:gravity="center_vertical"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:text="● EN PAUSA"
                        android:textColor="@color/amber_accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Carátula / Vinyl Card centrada con Badge de Formato y Ecualizador Animado -->
                    <FrameLayout
                        android:id="@+id/layoutAlbumArtCard"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_below="@id/tvPlaybackStatus"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:background="@drawable/bg_album_card">

                        <!-- Portada Real si existe en el archivo de audio -->
                        <ImageView
                            android:id="@+id/ivAlbumArt"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <!-- Contenedor Placeholder: Vinilo concéntrico + Ecualizador animado -->
                        <LinearLayout
                            android:id="@+id/layoutAlbumPlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingTop="8dp">

                            <!-- Disco de Vinilo (3 círculos concéntricos) -->
                            <ImageView
                                android:layout_width="68dp"
                                android:layout_height="68dp"
                                android:src="@drawable/ic_vinyl_disc" />

                            <!-- Barras de ecualizador animadas estilo web (5 barras cyan) -->
                            <com.jh.caraudio.SoundWaveBarsView
                                android:id="@+id/soundWaveBars"
                                android:layout_width="60dp"
                                android:layout_height="20dp"
                                android:layout_marginTop="6dp" />
                        </LinearLayout>

                        <!-- Badge de Formato / Calidad MP3 320K -->
                        <TextView
                            android:id="@+id/tvFormatBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="8dp"
                            android:background="@drawable/bg_pill"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:text="MP3 320K"
                            android:textColor="@color/accent_cyan"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <!-- Zona Táctil Ergonómica (Área libre marcada en cuadro rojo + botón de búsqueda) -->
                    <!-- Permite tocar, mantener y jalar hacia la izquierda para ocultar o hacia la derecha para mostrar -->
                    <LinearLayout
                        android:id="@+id/layoutExplorerToggleZone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/layoutAlbumArtCard"
                        android:layout_alignBottom="@id/layoutAlbumArtCard"
                        android:minWidth="64dp"
                        android:background="@android:color/transparent"
                        android:orientation="vertical"
                        android:gravity="top|start"
                        android:clickable="true"
                        android:focusable="false"
                        android:contentDescription="Área de gesto para alternar explorador">

                        <!-- Botón Alternar Buscador / Explorador de Música Ampliado para Conducción (54x48dp) -->
                        <ImageButton
                            android:id="@+id/btnToggleExplorer"
                            android:layout_width="54dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_btn_action"
                            android:src="@android:drawable/ic_menu_search"
                            android:tint="@color/accent_cyan"
                            android:padding="8dp"
                            android:contentDescription="Mostrar u Ocultar Explorador" />

                        <!-- Espacio libre táctil hacia abajo junto al disco para fácil pulsación/arrastre al manejar -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- Título de Canción: TIPOGRAFÍA GRANDE (25sp) Y MARQUESINA CONTINUA -->
                <TextView
                    android:id="@+id/tvTrackTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:scrollHorizontally="true"
                    android:text="Selecciona una canción"
                    android:textColor="@color/text_primary"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <!-- Artista (18sp Celeste Destacado) y Álbum (15sp) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/tvTrackArtist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="Artista"
                        android:textColor="@color/accent_cyan"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTrackArtistDot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" • "
                        android:textColor="@color/border_light"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvTrackAlbum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="Álbum"
                        android:textColor="@color/text_muted"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Tarjetas Flotantes: Pista Anterior y Posterior (Sleek 38dp) -->
                <LinearLayout
                    android:id="@+id/layoutAdjacentPreviews"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_search"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <!-- Tarjeta Anterior -->
                    <LinearLayout
                        android:id="@+id/layoutPrevCard"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackground">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="⏮ ANTERIOR"
                            android:textColor="@color/accent_cyan"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPrevTrackPreview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:singleLine="true"
                            android:ellipsize="marquee"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:text="Cargando..."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Divisor -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@color/border_panel" />

                    <!-- Tarjeta Siguiente -->
                    <LinearLayout
                        android:id="@+id/layoutNextCard"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackground">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="SIGUIENTE ⏭"
                            android:textColor="@color/accent_cyan"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvNextTrackPreview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:singleLine="true"
                            android:ellipsize="marquee"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:text="Cargando..."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Barra de Progreso y Tiempos: Con 20dp de separación segura de las tarjetas de anterior/siguiente -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical">

                    <SeekBar
                        android:id="@+id/seekTrackProgress"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:splitTrack="false"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:thumbOffset="9dp"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/seekbar_progress"
                        android:thumb="@drawable/seekbar_thumb" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:id="@+id/tvTimeCurrent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="00:00"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTimeTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="00:00"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </RelativeLayout>
                </LinearLayout>

                <!-- Controles de Transporte (Botones táctiles grandes ampliados) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="4dp">

                    <!-- Aleatorio -->
                    <ImageButton
                        android:id="@+id/btnShuffle"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_btn_action"
                        android:src="@android:drawable/ic_menu_rotate"
                        android:contentDescription="Aleatorio" />

                    <!-- Pista Anterior -->
                    <ImageButton
                        android:id="@+id/btnPrev"
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:layout_marginStart="14dp"
                        android:background="@drawable/bg_btn_action"
                        android:src="@android:drawable/ic_media_previous"
                        android:contentDescription="Anterior" />

                    <!-- Play / Pause Central Grande (78dp) -->
                    <ImageButton
                        android:id="@+id/btnPlayPause"
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_btn_circle"
                        android:src="@android:drawable/ic_media_play"
                        android:contentDescription="Play/Pause" />

                    <!-- Siguiente Pista -->
                    <ImageButton
                        android:id="@+id/btnNext"
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_btn_action"
                        android:src="@android:drawable/ic_media_next"
                        android:contentDescription="Siguiente" />

                    <!-- Repetir -->
                    <ImageButton
                        android:id="@+id/btnRepeat"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_btn_action"
                        android:src="@android:drawable/ic_menu_revert"
                        android:contentDescription="Repetir" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        

    </LinearLayout>

</LinearLayout>
